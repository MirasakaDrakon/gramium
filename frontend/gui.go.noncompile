// ---------- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ----------
var (
	appInstance     fyne.App
	mainWindow      fyne.Window
	gramiumNode     *Node
	selectedContact string
	chatMessages    []string
	chatListWidget  *widget.List
	contactListWidget *widget.List
	contactsData    []string
	messageEntry    *widget.Entry
)

// ---------- ЦВЕТА (как в макете) ----------
var (
	colorBgDark     = "#2A303C"
	colorBgLighter  = "#343B47"
	colorTextWhite  = "#FFFFFF"
	colorTextGrey   = "#888888"
	colorAccentBlue = "#4A90D9"
	colorRed        = "#E74C3C"
	colorRedDark    = "#8B1A1A"
)

// ---------- ОСНОВНАЯ ФУНКЦИЯ ----------
func main() {
	home, _ := os.UserHomeDir()
	os.MkdirAll(home+"/.gramium", 0700)

	// Загружаем метаданные
	meta := &PeerMeta{
		ClientName:    "Gramium-Desktop",
		ClientVersion: "1.0.0",
		Status:        "online",
	}
	metaFile := home + "/.gramium/meta.json"
	if data, err := os.ReadFile(metaFile); err == nil {
		json.Unmarshal(data, meta)
	} else {
		// Запрашиваем username
		meta.Username = "user"
	}

	cfg := &Config{
		Mode:   "speed",
		DBPath: home + "/.gramium/gramium.db",
	}

	if len(os.Args) > 1 && os.Args[1] == "--anonymity" {
		cfg.Mode = "anonymity"
	}

	// Создаём узел
	var err error
	gramiumNode, err = NewNode(cfg, meta)
	if err != nil {
		fmt.Println("❌ Ошибка запуска:", err)
		return
	}
	gramiumNode.Start()
	defer gramiumNode.Stop()

	// Запускаем GUI
	runGUI(meta)
}

// ---------- GUI ----------
func runGUI(meta *PeerMeta) {
	appInstance = app.New()
	mainWindow = appInstance.NewWindow("Gramium")
	mainWindow.Resize(fyne.NewSize(1100, 700))
	mainWindow.SetMaster()

	// Устанавливаем иконку приложения (опционально)
	// mainWindow.SetIcon(...

	// --- 1. ЛЕВАЯ НАВИГАЦИЯ ---
	navBar := createNavBar()

	// --- 2. ЦЕНТРАЛЬНАЯ ПАНЕЛЬ (Контакты / Чаты) ---
	centralContent := container.NewStack()
	conversationsView := createConversationsView()
	contactsView := createContactsView()
	centralContent.Add(conversationsView)

	// --- 3. ПРАВАЯ ПАНЕЛЬ (Чат / Детали) ---
	rightContent := container.NewStack()
	emptyView := widget.NewLabel("Выберите чат или контакт")
	rightContent.Add(emptyView)

	// Основной контейнер: навигация + центральная + правая
	mainContent := container.NewHSplit(
		container.NewPadded(navBar),
		container.NewHSplit(
			centralContent,
			rightContent,
		),
	)

	mainWindow.SetContent(mainContent)

	// --- Функция переключения между чатами и контактами ---
	switchToConversations := func() {
		centralContent.Objects = []fyne.CanvasObject{conversationsView}
		centralContent.Refresh()
	}
	switchToContacts := func() {
		centralContent.Objects = []fyne.CanvasObject{contactsView}
		centralContent.Refresh()
	}

	// --- Кнопки навигации ---
	// (будем использовать через createNavBar)

	mainWindow.ShowAndRun()
}

// ---------- СОЗДАНИЕ НАВИГАЦИОННОЙ ПАНЕЛИ ----------
func createNavBar() fyne.CanvasObject {
	// Логотип
	logo := widget.NewLabel("💬")
	logo.TextStyle = fyne.TextStyle{Bold: true}

	// Кнопки навигации (иконки)
	btnChats := widget.NewButtonWithIcon("", theme.ConversationIcon(), func() {})
	btnContacts := widget.NewButtonWithIcon("", theme.AccountIcon(), func() {})
	btnSearch := widget.NewButtonWithIcon("", theme.SearchIcon(), func() {})
	btnNotifications := widget.NewButtonWithIcon("", theme.MailIcon(), func() {})

	// Аватарка профиля снизу
	avatarLabel := widget.NewLabel("👤")

	navContainer := container.NewVBox(
		container.NewPadded(logo),
		widget.NewSeparator(),
		container.NewPadded(btnChats),
		container.NewPadded(btnContacts),
		container.NewPadded(btnSearch),
		container.NewPadded(btnNotifications),
		container.NewVBox(
			widget.NewSeparator(),
			container.NewPadded(avatarLabel),
		),
	)

	return container.NewBorder(nil, nil, nil, nil, navContainer)
}

// ---------- СОЗДАНИЕ СПИСКА ЧАТОВ ----------
func createConversationsView() fyne.CanvasObject {
	// Заголовок
	title := widget.NewLabelWithStyle("Conversations", fyne.TextAlignLeading, fyne.TextStyle{Bold: true})

	// Фильтры (табы)
	tabs := container.NewHBox(
		makeTab("All Active"),
		makeTab("Archive"),
		makeTab("Personal"),
	)

	// Кнопка "New Conversation"
	newBtn := widget.NewButtonWithIcon("New Conversation", theme.ContentAddIcon(), func() {
		// Диалог добавления контакта
		showAddContactDialog()
	})

	// Список чатов
	chatListWidget = widget.NewList(
		func() int { return len(chatMessages) },
		func() fyne.CanvasObject { return widget.NewLabel("") },
		func(i int, obj fyne.CanvasObject) {
			obj.(*widget.Label).SetText(chatMessages[i])
		},
	)

	// Компоновка
	return container.NewBorder(
		container.NewVBox(
			title,
			tabs,
			newBtn,
			widget.NewSeparator(),
		),
		nil, nil, nil,
		container.NewVScroll(chatListWidget),
	)
}

// ---------- СОЗДАНИЕ СПИСКА КОНТАКТОВ ----------
func createContactsView() fyne.CanvasObject {
	title := widget.NewLabelWithStyle("Contacts List", fyne.TextAlignLeading, fyne.TextStyle{Bold: true})

	// Favorites
	favBtn := widget.NewButton("★ Favorites", func() {})

	// Сортировка
	sortBtn := widget.NewButton("≡ A to z", func() {})

	// Кнопка "Add New Contact"
	addBtn := widget.NewButtonWithIcon("Add New Contact", theme.AccountIcon(), func() {
		showAddContactDialog()
	})

	// Список контактов (данные из БД)
	contactListWidget = widget.NewList(
		func() int { return len(contactsData) },
		func() fyne.CanvasObject {
			return container.NewHBox(
				widget.NewLabel(""),
				widget.NewLabel(""),
			)
		},
		func(i int, obj fyne.CanvasObject) {
			// TODO: заполнять данными из БД
		},
	)

	return container.NewBorder(
		container.NewVBox(
			title,
			favBtn,
			sortBtn,
			addBtn,
			widget.NewSeparator(),
		),
		nil, nil, nil,
		container.NewVScroll(contactListWidget),
	)
}

// ---------- СОЗДАНИЕ ЧАТА (правая панель) ----------
func createChatView(contactName string) fyne.CanvasObject {
	// Заголовок с именем контакта
	header := widget.NewLabelWithStyle(contactName, fyne.TextAlignLeading, fyne.TextStyle{Bold: true})

	// Список сообщений
	msgList := widget.NewList(
		func() int { return len(chatMessages) },
		func() fyne.CanvasObject {
			return container.NewHBox(
				widget.NewLabel(""),
				widget.NewLabel(""),
			)
		},
		func(i int, obj fyne.CanvasObject) {
			// TODO: отображать сообщения с разными стилями (свои/чужие)
		},
	)

	// Поле ввода + кнопка отправки
	messageEntry = widget.NewEntry()
	messageEntry.SetPlaceHolder("Введите сообщение...")
	sendBtn := widget.NewButtonWithIcon("", theme.MailSendIcon(), func() {
		msg := messageEntry.Text
		if msg == "" || selectedContact == "" {
			return
		}
		err := gramiumNode.SendMessage(selectedContact, []byte(msg))
		if err != nil {
			dialog.ShowError(err, mainWindow)
			return
		}
		chatMessages = append(chatMessages, "Я: "+msg)
		messageEntry.SetText("")
	})

	inputArea := container.NewBorder(nil, nil, nil, sendBtn, messageEntry)

	return container.NewBorder(
		header,
		inputArea,
		nil, nil,
		container.NewVScroll(msgList),
	)
}

// ---------- СОЗДАНИЕ ДЕТАЛЕЙ КОНТАКТА ----------
func createContactDetailsView(contactID string) fyne.CanvasObject {
	// Получаем метаданные контакта
	meta, err := gramiumNode.GetContactMeta(contactID)
	if err != nil {
		return widget.NewLabel("Контакт не найден")
	}

	// Аватарка
	avatar := widget.NewLabel("👤")
	avatar.TextStyle = fyne.TextStyle{Bold: true}

	// Имя
	nameLabel := widget.NewLabelWithStyle(meta.Username, fyne.TextAlignCenter, fyne.TextStyle{Bold: true})

	// Контакты (телефон, email - пока заглушки)
	phoneLabel := widget.NewLabel("+1-202-555-0105")
	emailLabel := widget.NewLabel("user@example.com")

	// Теги (Pill-кнопки)
	tags := container.NewHBox(
		makePillTag("#Brazil", "#4A90D9"),
		makePillTag("#Pharma", "#E67E22"),
		makePillTag("#CEO", "#8E44AD"),
	)

	// Разделитель
	sep := widget.NewSeparator()

	// Секция "CONVERSATIONS"
	convHeader := widget.NewLabelWithStyle("CONVERSATIONS (5)", fyne.TextAlignLeading, fyne.TextStyle{Bold: true})

	// Список переписок (заглушка)
	convItems := []string{
		"Anna Maven with Josh - Mar 25 2025",
		"Anna Maven with Jason - Jan 21 2025",
	}
	convList := widget.NewList(
		func() int { return len(convItems) },
		func() fyne.CanvasObject { return widget.NewLabel("") },
		func(i int, obj fyne.CanvasObject) {
			obj.(*widget.Label).SetText(convItems[i])
		},
	)

	return container.NewBorder(
		container.NewVBox(
			avatar,
			nameLabel,
			phoneLabel,
			emailLabel,
			tags,
			sep,
			convHeader,
		),
		nil, nil, nil,
		container.NewVScroll(convList),
	)
}

// ---------- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ----------

func makeTab(text string) *widget.Button {
	btn := widget.NewButton(text, func() {})
	btn.Importance = widget.LowImportance
	return btn
}

func makePillTag(text, color string) *widget.Button {
	btn := widget.NewButton(text, func() {})
	btn.Importance = widget.LowImportance
	return btn
}

func showAddContactDialog() {
	nameEntry := widget.NewEntry()
	nameEntry.SetPlaceHolder("Имя контакта")
	peerEntry := widget.NewEntry()
	peerEntry.SetPlaceHolder("Peer ID")

	items := []*widget.FormItem{
		widget.NewFormItem("Имя", nameEntry),
		widget.NewFormItem("Peer ID", peerEntry),
	}

	dialog.ShowForm("Добавить контакт", "Добавить", "Отмена", items, func(ok bool) {
		if ok {
			name := nameEntry.Text
			peerID := peerEntry.Text
			if name == "" || peerID == "" {
				dialog.ShowInformation("Ошибка", "Заполните все поля", mainWindow)
				return
			}
			err := gramiumNode.AddContact(name, peerID)
			if err != nil {
				dialog.ShowError(err, mainWindow)
			} else {
				dialog.ShowInformation("Успех", "Контакт добавлен", mainWindow)
				updateContactsList()
			}
		}
	}, mainWindow)
}

func updateContactsList() {
	// TODO: обновить список контактов из БД
	contacts, _ := gramiumNode.ListContacts()
	contactsData = contacts
	if contactListWidget != nil {
		contactListWidget.Refresh()
	}
}

