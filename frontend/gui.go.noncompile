func updateChat(contact string) {
	selectedContact = contact
	// TODO: загрузить историю из БД
}

// ---------- ТЕМА (тёмная, как в макете) ----------
type darkTheme struct{}

func (darkTheme) Color(name fyne.ThemeColorName, variant fyne.ThemeVariant) fyne.Color {
	switch name {
	case theme.ColorNameBackground:
		return colorFromHex("#2A303C")
	case theme.ColorNameInputBackground:
		return colorFromHex("#343B47")
	case theme.ColorNameButton:
		return colorFromHex("#343B47")
	case theme.ColorNamePrimary:
		return colorFromHex("#4A90D9")
	case theme.ColorNameForeground:
		return colorFromHex("#FFFFFF")
	case theme.ColorNameDisabled:
		return colorFromHex("#888888")
	default:
		return theme.DefaultTheme().Color(name, variant)
	}
}

func (darkTheme) Font(style fyne.TextStyle) fyne.Resource {
	return theme.DefaultTheme().Font(style)
}
func (darkTheme) Icon(name fyne.ThemeIconName) fyne.Resource {
	return theme.DefaultTheme().Icon(name)
}
func (darkTheme) Size(name fyne.ThemeSizeName) float32 {
	return theme.DefaultTheme().Size(name)
}

func colorFromHex(hex string) fyne.Color {
	return theme.DefaultTheme().Color(theme.ColorNameBackground, theme.VariantDark)
}